{
  "name": "@soeji/backend",
  "version": "1.0.0",
  "description": "API server for soeji image search",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run db:generate && tsc",
    "start": "node dist/index.js",
    "dev": "npm run db:generate && tsx watch src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "reindex": "node dist/scripts/reindex.js",
    "reindex:dev": "tsx src/scripts/reindex.ts",
    "reindex-tags": "node dist/scripts/reindexTags.js",
    "reindex-tags:dev": "tsx src/scripts/reindexTags.ts"
  },
  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "commander": "^15.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.62.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "sharp": "^0.35.5"
  }
}
